# BotTelegramRosa Environment Variables
# Copy this file to .env and fill in your values

# ─── Application Settings ───────────────────────────────────────────────────
APP_NAME=BotTelegramRosa
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ADMIN_TOKEN=change-this-admin-token

# ─── Server Settings ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=True

# ─── Telegram Bot Settings ───────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Set webhook URL if using webhooks instead of polling
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com

# ─── Stripe Settings ───────────────────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ─── Database Settings ───────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./bot.db

# PostgreSQL (production) - uncomment to use
# DATABASE_URL=postgresql://user:password@localhost:5432/bot_telegram_rosa

# ─── Scheduling Settings ───────────────────────────────────────────────────────
# Default interval between messages in hours
MESSAGE_SENDING_INTERVAL=2

# How often to check for scheduled messages (in seconds)
CHECK_SCHEDULE_EVERY=60

# ─── VIP Channel Settings ───────────────────────────────────────────────────────
# Your VIP Telegram channel invite link
# Format: https://t.me/+xxxxxxxxxxxxx
VIP_CHANNEL_INVITE_LINK=https://t.me/+your_channel_link_here

# ─── Language Settings ───────────────────────────────────────────────────────
# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=es,en,fr,de,it,pt,ru
